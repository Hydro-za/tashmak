# Public values (safe to expose in the browser). Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the "publishable" (or legacy "anon") key. NEVER put the service_role / secret key in this app.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
